@page "/members"
@attribute [Authorize(Roles = "Admin")]
@using BODA.VMS.MLOps.Contracts.Members
@inject MlopsApi Api
@inject ISnackbar Snackbar
@inject IDialogService Dialogs

<PageTitle>사용자 역할 · MLOps</PageTitle>

<PageHeader Eyebrow="ADMINISTRATION" Title="사용자 역할">
    <Lead>
        @if (_local)
        {
            <span>
                이 서버가 계정을 직접 관리합니다 (운영 웹이 없는 설치). 계정을 올리고 역할을 붙인 뒤
                <b>임시 비밀번호</b>를 내주세요 — 받은 사람은 첫 로그인에서 비밀번호를 바꿔야 합니다.
            </span>
        }
        else
        {
            <span>
                로그인은 BODA VMS Web 이 확인하고, 그 사람이 MLOps 에서 무엇을 할 수 있는지는 여기가 정합니다.
                운영 웹의 계정 이름을 올리고 역할을 붙이세요. 운영 웹 쪽 설정은 바뀌지 않습니다.
            </span>
        }
    </Lead>
    <Actions>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.PersonAdd"
                   OnClick="@(() => OpenGrant(null))">역할 주기</MudButton>
    </Actions>
</PageHeader>

@if (_error is not null)
{
    <MudAlert Severity="Severity.Error" Class="mb-4">@_error</MudAlert>
}

@if (_policy is not null)
{
    <MudAlert Severity="Severity.Info" Class="mb-4" Icon="@Icons.Material.Filled.Info">
        <MudText Typo="Typo.body2">
            @if (string.IsNullOrWhiteSpace(_policy.DefaultRole))
            {
                <span>이 목록에 없는 계정은 <b>아무 화면도 열지 못합니다.</b></span>
            }
            else
            {
                <span>이 목록에 없는 계정은 <b>@_policy.DefaultRole</b> 로 들어옵니다.</span>
            }
            @* 운영 웹 역할로 들어오는 통로는 Web 모드에만 있다. *@
            @if (!_local && !string.IsNullOrWhiteSpace(_policy.BootstrapWebRole))
            {
                <span>
                    운영 웹에서 <b>@_policy.BootstrapWebRole</b> 인 계정은 목록에 없어도 관리자로 들어옵니다 —
                    여기에 줄을 만들면 그쪽이 이깁니다.
                </span>
            }
        </MudText>
    </MudAlert>
}

@if (_loading)
{
    <MudProgressLinear Indeterminate="true" />
}
else if (_members.Count == 0)
{
    <MudPaper Class="pa-8 d-flex flex-column align-center" Outlined="true">
        <MudIcon Icon="@Icons.Material.Filled.ManageAccounts" Size="Size.Large" Class="mud-text-secondary" />
        <MudText Typo="Typo.body1" Class="mt-2">역할을 붙인 계정이 없습니다.</MudText>
        <MudText Typo="Typo.body2" Class="mud-text-secondary mt-1">
            라벨링을 맡길 사람부터 올리세요.
            @(_local ? "올린 뒤 임시 비밀번호를 내주면 그 사람이 로그인할 수 있습니다." : "운영 웹에서 쓰는 계정 이름 그대로 넣으면 됩니다.")
        </MudText>
    </MudPaper>
}
else
{
    <MudPaper Elevation="1">
        <MudTable Items="@_members" Dense="true" Hover="true" Breakpoint="Breakpoint.Sm">
            <HeaderContent>
                <MudTh>계정</MudTh>
                <MudTh>역할</MudTh>
                <MudTh>메모</MudTh>
                <MudTh>준 사람</MudTh>
                <MudTh>마지막 접속</MudTh>
                <MudTh>상태</MudTh>
                <MudTh></MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="계정">
                    <MudText Typo="Typo.body2"><b>@context.Username</b></MudText>
                    @if (!string.IsNullOrWhiteSpace(context.DisplayName))
                    {
                        <MudText Typo="Typo.caption" Class="mud-text-secondary">@context.DisplayName</MudText>
                    }
                </MudTd>
                <MudTd DataLabel="역할">
                    <MudChip T="string" Size="Size.Small" Color="@ColorOf(context.Role)">@context.Role</MudChip>
                </MudTd>
                <MudTd DataLabel="메모">
                    <MudText Typo="Typo.caption" Class="mud-text-secondary">@context.Note</MudText>
                </MudTd>
                <MudTd DataLabel="준 사람">
                    <MudText Typo="Typo.caption" Class="mud-text-secondary">
                        @context.GrantedBy · @context.GrantedAt.ToLocalTime().ToString("yyyy-MM-dd")
                    </MudText>
                </MudTd>
                <MudTd DataLabel="마지막 접속">
                    <MudText Typo="Typo.caption" Class="mud-text-secondary">
                        @(context.LastSeenAt is null ? "없음" : context.LastSeenAt.Value.ToLocalTime().ToString("yyyy-MM-dd HH:mm"))
                    </MudText>
                </MudTd>
                <MudTd DataLabel="상태">
                    @if (context.Disabled)
                    {
                        <MudChip T="string" Size="Size.Small" Color="Color.Error">비활성</MudChip>
                    }
                    else if (_local && !context.HasPassword)
                    {
                        <MudChip T="string" Size="Size.Small" Color="Color.Warning">비밀번호 없음</MudChip>
                    }
                    else if (_local && context.MustChangePassword)
                    {
                        <MudChip T="string" Size="Size.Small" Color="Color.Warning">임시 비밀번호</MudChip>
                    }
                    else if (context.LockedUntil is { } until && until > DateTime.UtcNow)
                    {
                        <MudChip T="string" Size="Size.Small" Color="Color.Warning">잠김</MudChip>
                    }
                    else
                    {
                        <MudText Typo="Typo.caption" Class="mud-text-secondary">정상</MudText>
                    }
                </MudTd>
                <MudTd Class="text-right">
                    @if (_local)
                    {
                        <MudButton Size="Size.Small" OnClick="@(() => ResetPasswordAsync(context))">임시 비밀번호</MudButton>
                    }
                    <MudButton Size="Size.Small" OnClick="@(() => ToggleDisabledAsync(context))">
                        @(context.Disabled ? "되살리기" : "비활성")
                    </MudButton>
                    <MudButton Size="Size.Small" OnClick="@(() => OpenGrant(context))">역할 바꾸기</MudButton>
                    <MudButton Size="Size.Small" Color="Color.Error" OnClick="@(() => RevokeAsync(context))">거두기</MudButton>
                </MudTd>
            </RowTemplate>
        </MudTable>
    </MudPaper>
}

@* 임시 비밀번호는 여기서 한 번만 보인다. 서버에는 해시만 남아 다시 볼 방법이 없다. *@
<MudDialog @bind-Visible="_passwordOpen" Options="new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true }">
    <TitleContent><MudText Typo="Typo.h6">임시 비밀번호</MudText></TitleContent>
    <DialogContent>
        <MudText Typo="Typo.body2" Class="mb-3">
            <b>@_passwordUser</b> 에게 이 비밀번호를 전하세요. <b>이 창을 닫으면 다시 볼 수 없습니다</b> —
            잃어버리면 다시 내주면 됩니다.
        </MudText>
        <MudTextField T="string" Value="@_passwordValue" ReadOnly="true" Variant="Variant.Outlined" Class="mono" />
        <MudText Typo="Typo.caption" Class="mud-text-secondary mt-2">
            받은 사람은 첫 로그인에서 비밀번호를 바꿔야 하고, 바꾸기 전에는 다른 화면이 열리지 않습니다.
        </MudText>
    </DialogContent>
    <DialogActions>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="@(() => _passwordOpen = false)">닫기</MudButton>
    </DialogActions>
</MudDialog>

<MudDialog @bind-Visible="_grantOpen" Options="new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true }">
    <TitleContent><MudText Typo="Typo.h6">@(_editing is null ? "역할 주기" : "역할 바꾸기")</MudText></TitleContent>
    <DialogContent>
        <MudTextField @bind-Value="_username" Label="@(_local ? "계정 이름" : "운영 웹 계정 이름")" Immediate="true"
                      Disabled="@(_editing is not null)" HelperText="로그인할 때 쓰는 이름 그대로. 대소문자는 가리지 않습니다." />
        <MudSelect T="string" @bind-Value="_role" Label="역할" Class="mt-4">
            @foreach (var r in _assignable)
            {
                <MudSelectItem T="string" Value="@r">@r — @Explain(r)</MudSelectItem>
            }
        </MudSelect>
        <MudTextField @bind-Value="_note" Label="메모 (선택)" Class="mt-4"
                      HelperText="왜 이 역할을 주었는지. 나중에 정리할 때 도움이 됩니다." />
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="@(() => _grantOpen = false)">취소</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" Disabled="@(string.IsNullOrWhiteSpace(_username) || _busy)"
                   OnClick="GrantAsync">저장</MudButton>
    </DialogActions>
</MudDialog>

@code {
    private List<MemberDto> _members = [];
    private MemberPolicyDto? _policy;
    private string[] _assignable = ["Viewer", "Labeler", "Engineer", "Admin"];
    private bool _loading = true, _busy, _grantOpen, _passwordOpen, _local;
    private string? _error;
    private string _passwordUser = "", _passwordValue = "";

    private MemberDto? _editing;
    private string _username = "", _role = "Viewer", _note = "";

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        _loading = true;
        _error = null;
        try
        {
            // 자체 계정 모드에서만 비밀번호를 우리가 들고 있다 — 그 모드에서만 계정 관리 버튼을 보여 준다.
            try { _local = (await Api.AuthModeAsync()).Mode.Equals("Local", StringComparison.OrdinalIgnoreCase); }
            catch (MlopsApiException) { _local = false; }

            _members = await Api.MembersAsync();
            _policy = await Api.MemberPolicyAsync();
            if (_policy.AssignableRoles.Length > 0) _assignable = _policy.AssignableRoles;
        }
        catch (MlopsApiException ex) { _error = ex.Describe(); }
        finally { _loading = false; }
    }

    private void OpenGrant(MemberDto? member)
    {
        _editing = member;
        _username = member?.Username ?? "";
        _role = member?.Role ?? "Viewer";
        _note = member?.Note ?? "";
        _grantOpen = true;
    }

    private async Task GrantAsync()
    {
        _busy = true;
        try
        {
            await Api.GrantMemberAsync(new GrantMemberRequest(_username, _role, _editing?.DisplayName, _note));
            Snackbar.Add($"{_username} → {_role}", Severity.Success);
            _grantOpen = false;
            await LoadAsync();
        }
        catch (MlopsApiException ex) { Snackbar.Add(ex.Describe(), Severity.Error); }
        finally { _busy = false; }
    }

    private async Task RevokeAsync(MemberDto member)
    {
        var ok = await Dialogs.ShowMessageBox("역할 거두기",
            $"{member.Username} 의 역할을 거둡니다. 다음 요청부터 바로 적용됩니다.",
            yesText: "거두기", cancelText: "취소");
        if (ok != true) return;

        try
        {
            await Api.RevokeMemberAsync(member.Id);
            Snackbar.Add($"{member.Username} 의 역할을 거두었습니다", Severity.Success);
            await LoadAsync();
        }
        catch (MlopsApiException ex) { Snackbar.Add(ex.Describe(), Severity.Error); }
    }

    private async Task ResetPasswordAsync(MemberDto member)
    {
        var ok = await Dialogs.ShowMessageBox("임시 비밀번호 내주기",
            $"{member.Username} 의 비밀번호를 새 임시 비밀번호로 바꿉니다. 지금 쓰던 비밀번호와 로그인해 둔 세션은 끊깁니다.",
            yesText: "내주기", cancelText: "취소");
        if (ok != true) return;

        try
        {
            var issued = await Api.ResetMemberPasswordAsync(member.Id);
            _passwordUser = issued.Username;
            _passwordValue = issued.TemporaryPassword;
            _passwordOpen = true;
            await LoadAsync();
        }
        catch (MlopsApiException ex) { Snackbar.Add(ex.Describe(), Severity.Error); }
    }

    private async Task ToggleDisabledAsync(MemberDto member)
    {
        var disable = !member.Disabled;
        if (disable)
        {
            var ok = await Dialogs.ShowMessageBox("계정 비활성",
                $"{member.Username} 을(를) 막습니다. 로그인해 둔 토큰도 다음 요청부터 막힙니다.",
                yesText: "비활성", cancelText: "취소");
            if (ok != true) return;
        }

        try
        {
            await Api.SetMemberDisabledAsync(member.Id, disable);
            Snackbar.Add($"{member.Username} 을(를) {(disable ? "비활성했습니다" : "되살렸습니다")}", Severity.Success);
            await LoadAsync();
        }
        catch (MlopsApiException ex) { Snackbar.Add(ex.Describe(), Severity.Error); }
    }

    private static Color ColorOf(string role) => role switch
    {
        "Admin" => Color.Primary,
        "Engineer" => Color.Info,
        "Labeler" => Color.Success,
        _ => Color.Default,
    };

    private static string Explain(string role) => role switch
    {
        "Viewer" => "보기만",
        "Labeler" => "라벨링까지",
        "Engineer" => "데이터셋·학습·Staging 승격까지",
        "Admin" => "Production 승격·계정 발급까지",
        _ => "",
    };
}
