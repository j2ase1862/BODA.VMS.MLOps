@page "/change-password"
@* 자체 계정 모드(Auth:Mode=Local)에서만 뜻이 있는 화면. 임시 비밀번호를 푸는 유일한 통로이기도 하다 —
   그 상태에서는 역할이 없어 다른 화면이 모두 막히므로, 여기는 역할을 요구하지 않는다. *@
@attribute [Authorize]
@inject MlopsApi Api
@inject JwtAuthenticationStateProvider Auth
@inject NavigationManager Nav
@inject ISnackbar Snackbar

<PageTitle>비밀번호 변경</PageTitle>

<MudContainer MaxWidth="MaxWidth.Small" Class="mt-12">
    <MudPaper Class="pa-8" Elevation="2">
        <MudText Typo="Typo.h6" Class="mb-2">비밀번호 변경</MudText>
        <MudText Typo="Typo.body2" Class="mb-6 mud-text-secondary">
            바꾸면 다른 자리에 로그인해 둔 세션은 즉시 끊깁니다. 이 창은 그대로 쓸 수 있습니다.
        </MudText>

        <EditForm Model="@this" OnValidSubmit="SubmitAsync">
            <MudTextField @bind-Value="_current" Label="지금 비밀번호" Variant="Variant.Outlined"
                          InputType="InputType.Password" Immediate="true" Disabled="@_busy" />
            <MudTextField @bind-Value="_next" Label="새 비밀번호" Variant="Variant.Outlined"
                          InputType="InputType.Password" Class="mt-4" Immediate="true" Disabled="@_busy"
                          HelperText="8자 이상" />
            <MudTextField @bind-Value="_confirm" Label="새 비밀번호 확인" Variant="Variant.Outlined"
                          InputType="InputType.Password" Class="mt-4" Immediate="true" Disabled="@_busy" />

            <MudButton ButtonType="ButtonType.Button" OnClick="SubmitAsync" Class="mt-6" FullWidth="true"
                       Variant="Variant.Filled" Color="Color.Primary" Disabled="@(_busy || !Ready)">
                @(_busy ? "바꾸는 중…" : "비밀번호 바꾸기")
            </MudButton>
        </EditForm>

        @if (_error is not null)
        {
            <MudAlert Severity="Severity.Error" Class="mt-4">@_error</MudAlert>
        }
    </MudPaper>
</MudContainer>

@code {
    private string _current = "", _next = "", _confirm = "";
    private string? _error;
    private bool _busy;

    private bool Ready =>
        _current.Length > 0 && _next.Length > 0 && _next == _confirm;

    private async Task SubmitAsync()
    {
        if (!Ready)
        {
            _error = "새 비밀번호와 확인이 다릅니다.";
            return;
        }

        _busy = true;
        _error = null;
        try
        {
            // 새 토큰에는 새 세대가 찍혀 있다. 이것으로 갈아타지 않으면 방금 바꾼 본인이 바로 막힌다.
            var result = await Api.ChangePasswordAsync(_current, _next);
            await Auth.SignInAsync(result.Token);
            await Api.EnsureImageCookieAsync();
            Snackbar.Add("비밀번호를 바꿨습니다.", Severity.Success);
            Nav.NavigateTo("/");
        }
        catch (MlopsApiException ex) { _error = ex.Describe(); }
        finally { _busy = false; _current = _next = _confirm = ""; }
    }
}
