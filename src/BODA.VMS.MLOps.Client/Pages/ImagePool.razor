@page "/images"
@attribute [Authorize]
@implements IAsyncDisposable
@inject MlopsApi Api
@inject ISnackbar Snackbar
@inject NavigationManager Nav
@inject IDialogService Dialogs
@inject IJSRuntime JS

<PageTitle>수집 사진 · MLOps</PageTitle>

<PageHeader Eyebrow="DATA" Title="수집 사진">
    <Lead>
        라인 PC 가 올린 NG 사진과 양품 샘플, 사람이 올린 사진이 모두 모이는 곳입니다.
        아직 어느 데이터셋에도 담기지 않은 사진을 골라 데이터셋에 담으면 라벨링을 시작할 수 있습니다.
    </Lead>
    <Actions>
        <AuthorizeView Roles="Labeler,Engineer,Admin">
            <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.CloudUpload"
                       OnClick="@(() => _uploadOpen = true)">사진 올리기</MudButton>
        </AuthorizeView>
    </Actions>
</PageHeader>

@if (_error is not null)
{
    <MudAlert Severity="Severity.Error" Class="mb-3">@_error</MudAlert>
}

<MudPaper Class="pa-3 mb-3" Outlined="true">
    <div class="d-flex flex-wrap gap-3 align-center">
        <MudSelect T="ImageSource?" Value="_source" ValueChanged="OnSourceChanged" Label="출처" Clearable="true"
                   Margin="Margin.Dense" Style="min-width:160px">
            <MudSelectItem T="ImageSource?" Value="ImageSource.LineNg">라인 NG · 양품 샘플</MudSelectItem>
            <MudSelectItem T="ImageSource?" Value="ImageSource.Manual">직접 올림</MudSelectItem>
        </MudSelect>
        <MudCheckBox T="bool" Value="_onlyUnassigned" ValueChanged="OnUnassignedChanged" Label="데이터셋에 안 담긴 것만" Dense="true" />
        <MudTextField @bind-Value="_tag" Label="태그 (예: verdict:ng, recipe:PUT-10)" Margin="Margin.Dense" Immediate="true"
                      OnKeyUp="OnSearchKeyAsync" Style="min-width:220px" />
        <MudTextField @bind-Value="_search" Label="파일명 검색" Margin="Margin.Dense" Immediate="true"
                      Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search"
                      OnKeyUp="OnSearchKeyAsync" Style="min-width:180px" />
        <MudButton Variant="Variant.Outlined" Size="Size.Small" OnClick="@(() => LoadAsync())">조회</MudButton>
        <MudSpacer />
        <MudText Typo="Typo.body2" Class="mud-text-secondary">@_total 장</MudText>
        @if (_selection.Count > 0)
        {
            <MudText Typo="Typo.body2">@(_selection.Count)장 선택</MudText>
            <AuthorizeView Roles="Labeler,Engineer,Admin">
                <MudButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Primary"
                           StartIcon="@Icons.Material.Filled.PlaylistAdd" OnClick="OpenAddDialog">데이터셋에 담기</MudButton>
            </AuthorizeView>
            <AuthorizeView Roles="Labeler,Engineer,Admin" Context="crop">
                <MudButton Size="Size.Small" Variant="Variant.Outlined"
                           StartIcon="@Icons.Material.Filled.Crop" OnClick="@(() => _cropOpen = true)">ROI 로 자르기</MudButton>
            </AuthorizeView>
            <AuthorizeView Roles="Engineer,Admin" Context="del">
                <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Error"
                           StartIcon="@Icons.Material.Filled.DeleteOutline" Disabled="@_busy"
                           OnClick="DeleteSelectedAsync">영구 삭제</MudButton>
            </AuthorizeView>
            <MudButton Size="Size.Small" Variant="Variant.Text"
                       Disabled="@(_selection.Count == _images.Count)" OnClick="SelectAll">보이는 것 전부 선택</MudButton>
            <MudButton Size="Size.Small" Variant="Variant.Text" OnClick="ClearSelection">선택 해제</MudButton>
        }
        else if (_images.Count > 0)
        {
            <MudButton Size="Size.Small" Variant="Variant.Text"
                       StartIcon="@Icons.Material.Filled.SelectAll" OnClick="SelectAll">보이는 것 전부 선택</MudButton>
            <MudText Typo="Typo.caption" Class="mud-text-secondary">
                Ctrl+클릭으로 하나씩 · Shift+클릭으로 사이를 한꺼번에 · Ctrl+A 전부 · Esc 해제
            </MudText>
        }
    </div>
</MudPaper>

@if (_loading)
{
    <MudProgressLinear Indeterminate="true" />
}
else if (_images.Count == 0)
{
    <MudPaper Class="pa-8 d-flex flex-column align-center" Outlined="true">
        <MudIcon Icon="@Icons.Material.Filled.PhotoLibrary" Size="Size.Large" class="mud-text-secondary" />
        <MudText Typo="Typo.body1" Class="mt-2">조건에 맞는 사진이 없습니다.</MudText>
        <MudText Typo="Typo.caption" Class="mud-text-secondary mt-1">
            내 PC 에 있는 사진은 오른쪽 위 [사진 올리기] 로 끌어다 놓거나 골라서 올릴 수 있습니다.
        </MudText>
        <MudText Typo="Typo.caption" Class="mud-text-secondary">
            라인 사진은 라인 PC 의 이미지 저장 설정에서 [NG 이미지 MLOps 전송] 을 켜야 올라옵니다. 라인 PC 화면에서 등록·토큰을 확인하세요.
        </MudText>
    </MudPaper>
}
else
{
    @* Shift+클릭은 브라우저의 글자 끌어 고르기와 겹친다. 끄지 않으면 파일 이름들이
       파랗게 칠해져 격자가 지저분해진다. *@
    <div style="display:grid; grid-template-columns:repeat(auto-fill, minmax(180px, 1fr)); gap:12px; user-select:none">
        @foreach (var image in _images)
        {
            var selected = _selection.Contains(image.Id);
            var verdict = image.Tags.FirstOrDefault(t => t.StartsWith("verdict:", StringComparison.OrdinalIgnoreCase))?["verdict:".Length..];
            <MudPaper Elevation="@(selected ? 6 : 1)" Class="pa-1"
                      Style="@($"position:relative; cursor:pointer; outline:{(selected ? "3px solid var(--mud-palette-primary)" : "none")}")"
                      @onclick="@(e => OnCardClick(image.Id, e))">
                <img src="@image.ThumbnailUrl" alt="@image.FileName" loading="lazy"
                     style="width:100%; aspect-ratio:4/3; object-fit:cover; border-radius:3px; display:block" />
                <div style="position:absolute; top:6px; left:6px; display:flex; gap:4px">
                    @if (verdict is not null)
                    {
                        <MudChip T="string" Size="Size.Small" Color="@(verdict.Equals("ng", StringComparison.OrdinalIgnoreCase) ? Color.Error : Color.Success)">
                            @verdict.ToUpperInvariant()
                        </MudChip>
                    }
                    @if (image.Source == ImageSource.LineNg && !string.IsNullOrEmpty(image.LineId))
                    {
                        <MudChip T="string" Size="Size.Small">@image.LineId</MudChip>
                    }
                </div>
                <div class="pa-1">
                    <MudText Typo="Typo.caption" Style="display:block; overflow:hidden; text-overflow:ellipsis; white-space:nowrap">
                        @image.FileName
                    </MudText>
                    <MudText Typo="Typo.caption" Class="mud-text-secondary" Style="display:block; overflow:hidden; text-overflow:ellipsis; white-space:nowrap">
                        @((image.CapturedAt ?? image.CreatedAt).ToLocalTime().ToString("MM-dd HH:mm")) · @image.Width×@image.Height
                        @if (image.Tags.FirstOrDefault(t => t.StartsWith("recipe:")) is { } r) { <text> · @r["recipe:".Length..]</text> }
                    </MudText>
                </div>
            </MudPaper>
        }
    </div>
    @if (_images.Count < _total)
    {
        <div class="d-flex justify-center mt-3">
            <MudButton Variant="Variant.Outlined" OnClick="LoadMoreAsync">더 보기 (@_images.Count / @_total)</MudButton>
        </div>
    }
}

<ImageUploadDialog @bind-Visible="_uploadOpen" OnUploaded="OnUploadedAsync" />

<RoiCropDialog @bind-Visible="_cropOpen" ImageIds="@_selection.ToArray()" OnCropped="OnCroppedAsync" />

<MudDialog @bind-Visible="_addOpen" Options="@(new DialogOptions { CloseOnEscapeKey = true, MaxWidth = MaxWidth.Small, FullWidth = true })">
    <TitleContent><MudText Typo="Typo.h6">데이터셋에 담기</MudText></TitleContent>
    <DialogContent>
        <MudText Typo="Typo.body2" Class="mb-2">선택한 @(_selection.Count)장을 담을 데이터셋과 분할을 고르세요. 사진은 복제되지 않고 참조로 담깁니다.</MudText>
        <MudSelect T="Guid?" @bind-Value="_targetDatasetId" Label="데이터셋" Margin="Margin.Dense">
            @foreach (var d in _datasets)
            {
                <MudSelectItem T="Guid?" Value="@d.Id">@d.Name (@d.TaskType, @d.Classes.Length 클래스)</MudSelectItem>
            }
        </MudSelect>
        <MudSelect T="DatasetSplit" @bind-Value="_targetSplit" Label="분할" Margin="Margin.Dense" Class="mt-2">
            @foreach (var s in Enum.GetValues<DatasetSplit>())
            {
                <MudSelectItem T="DatasetSplit" Value="@s">@Display.SplitText(s)</MudSelectItem>
            }
        </MudSelect>
        @if (_datasets.Count == 0)
        {
            <MudAlert Severity="Severity.Info" Class="mt-2">데이터셋이 없습니다. 먼저 "데이터셋 · 라벨링" 에서 하나 만드세요.</MudAlert>
        }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="@(() => _addOpen = false)">취소</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" Disabled="@(_targetDatasetId is null || _busy)" OnClick="AddSelectedAsync">담기</MudButton>
    </DialogActions>
</MudDialog>

@code {
    private List<ImageDto> _images = [];
    private readonly GridSelection _selection = new();
    private IJSObjectReference? _keys;
    private DotNetObjectReference<ImagePool>? _self;
    private List<DatasetDto> _datasets = [];
    private ImageSource? _source = ImageSource.LineNg;
    private bool _onlyUnassigned = true;
    private string _tag = "", _search = "";
    private int _total;
    private bool _loading, _busy, _addOpen, _uploadOpen, _cropOpen;
    private Guid? _targetDatasetId;
    private DatasetSplit _targetSplit = DatasetSplit.Train;
    private string? _error;

    protected override Task OnInitializedAsync() => LoadAsync();

    /// <summary>격자 단축키를 듣는 범위 이름. 화면마다 하나씩 등록하고 나갈 때 뗀다.</summary>
    private const string KeyScope = "image-pool";

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        try
        {
            _self = DotNetObjectReference.Create(this);
            _keys = await JS.InvokeAsync<IJSObjectReference>("import", "./js/grid-keys.js");
            await _keys.InvokeVoidAsync("register", KeyScope, _self);
        }
        // 단축키는 편의다 — 못 붙어도 화면은 그대로 써야 한다.
        catch (JSException) { }
        catch (JSDisconnectedException) { }
    }

    public async ValueTask DisposeAsync()
    {
        if (_keys is not null)
        {
            try { await _keys.InvokeVoidAsync("unregister", KeyScope); await _keys.DisposeAsync(); }
            catch (JSDisconnectedException) { }
        }
        _self?.Dispose();
    }

    private async Task LoadAsync(bool append = false)
    {
        _loading = !append;
        try
        {
            var page = await Api.ImagesAsync(null,
                inDataset: _onlyUnassigned ? false : null,
                source: _source,
                tag: string.IsNullOrWhiteSpace(_tag) ? null : _tag.Trim(),
                search: string.IsNullOrWhiteSpace(_search) ? null : _search.Trim(),
                skip: append ? _images.Count : 0, take: 60);
            _images = append ? [.. _images, .. page.Items] : page.Items.ToList();
            _total = page.Total;
            // 다시 읽으면 걸러져 사라진 사진이 생긴다. 안 보이는 것을 고른 채로 두면
            // 다음에 누르는 [담기]·[삭제] 가 화면에 없는 사진에 걸린다.
            if (append) _selection.KeepOnly(_images.Select(i => i.Id).ToHashSet());
            else _selection.Clear();
            _error = null;
        }
        catch (MlopsApiException ex) { _error = ex.Describe(); }
        finally { _loading = false; }
    }

    private Task LoadMoreAsync() => LoadAsync(append: true);

    /// <summary>
    /// 올린 사진이 목록에 보이게 한다. 기본 거르개는 [라인 NG] 라 방금 올린 사진이 그대로면 안 보인다 —
    /// "올렸는데 아무 일도 없다" 로 읽히므로 출처를 풀어 준다.
    /// </summary>
    private async Task OnUploadedAsync(int count)
    {
        if (count > 0 && _source is not null) _source = null;
        await LoadAsync();
    }
    /// <summary>
    /// 자른 사진은 출처를 원본에서 물려받으므로, 라인 NG 사진을 잘랐으면 거르개를 그대로 두어도 보인다.
    /// 다만 [데이터셋에 안 담긴 것만] 이 켜져 있고 바로 담았으면 안 보이므로 그것만 풀어 준다.
    /// </summary>
    private async Task OnCroppedAsync(int count)
    {
        if (count > 0 && _onlyUnassigned) _onlyUnassigned = false;
        _selection.Clear();
        await LoadAsync();
    }

    private Task OnSourceChanged(ImageSource? v) { _source = v; return LoadAsync(); }
    private Task OnUnassignedChanged(bool v) { _onlyUnassigned = v; return LoadAsync(); }
    private async Task OnSearchKeyAsync(KeyboardEventArgs e) { if (e.Key == "Enter") await LoadAsync(); }

    /// <summary>
    /// 격자에서 사진을 눌렀을 때. Shift+클릭의 범위는 <b>화면에 보이는 순서</b>로 셈한다 —
    /// 사람이 "A 부터 H 까지" 라고 할 때 뜻하는 것이 그 순서다.
    /// </summary>
    private void OnCardClick(Guid id, MouseEventArgs e) =>
        _selection.Click(id, e.ShiftKey, e.CtrlKey || e.MetaKey, _images.Select(i => i.Id).ToList());

    [JSInvokable]
    public Task SelectAll()
    {
        _selection.SelectAll(_images.Select(i => i.Id).ToList());
        StateHasChanged();
        return Task.CompletedTask;
    }

    [JSInvokable]
    public Task ClearSelection()
    {
        _selection.Clear();
        StateHasChanged();
        return Task.CompletedTask;
    }

    private async Task OpenAddDialog()
    {
        try { _datasets = await Api.DatasetListAsync(); }
        catch (MlopsApiException ex) { Snackbar.Add(ex.Describe(), Severity.Error); return; }
        _targetDatasetId ??= _datasets.FirstOrDefault()?.Id;
        _addOpen = true;
    }

    /// <summary>
    /// 고른 사진을 저장소에서 지운다. 데이터셋 버전(스냅샷)에 들어간 사진이 하나라도 섞여 있으면
    /// 서버가 전부 막는다 — 굳은 판이 재현되지 않기 때문이다.
    /// </summary>
    private async Task DeleteSelectedAsync()
    {
        var ok = await Dialogs.ShowMessageBox("사진 영구 삭제",
            $"고른 {_selection.Count}장을 저장소에서 지웁니다. 담겨 있던 데이터셋의 라벨도 함께 사라집니다. " +
            "데이터셋 버전에 들어간 사진이 섞여 있으면 아무것도 지워지지 않습니다. 되돌릴 수 없습니다.",
            yesText: "삭제", cancelText: "취소");
        if (ok != true) return;

        _busy = true;
        try
        {
            var deleted = await Api.DeleteImagesAsync(_selection.ToArray());
            Snackbar.Add($"{deleted}장을 지웠습니다", Severity.Success);
            await LoadAsync();
        }
        catch (MlopsApiException ex) { Snackbar.Add(ex.Describe(), Severity.Error); }
        finally { _busy = false; }
    }

    private async Task AddSelectedAsync()
    {
        if (_targetDatasetId is not { } datasetId) return;
        _busy = true;
        try
        {
            var ids = _selection.ToArray();
            await Api.AddImagesAsync(datasetId, ids, _targetSplit);
            var name = _datasets.FirstOrDefault(d => d.Id == datasetId)?.Name ?? "데이터셋";
            Snackbar.Add($"{ids.Length}장을 '{name}' 에 담았습니다.", Severity.Success);
            _addOpen = false;
            await LoadAsync();   // "안 담긴 것만" 필터면 목록에서 빠진다
        }
        catch (MlopsApiException ex) { Snackbar.Add(ex.Describe(), Severity.Error); }
        finally { _busy = false; }
    }
}
