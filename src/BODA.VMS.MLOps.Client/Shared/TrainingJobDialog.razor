@* 학습 작업 제출 (Phase 3 §9). 하이퍼파라미터 항목은 서버의 화이트리스트에서 받아 그린다. *@
@inject MlopsApi Api

<MudDialog Visible="Visible" VisibleChanged="VisibleChanged"
           Options="new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true }">
    <TitleContent><MudText Typo="Typo.h6">@(PrefillFromJobId is null ? "학습 작업 제출" : "재학습 제출")</MudText></TitleContent>
    <DialogContent>
        @if (_loading)
        {
            <MudProgressLinear Indeterminate="true" />
        }
        else
        {
            @if (_prefilled)
            {
                @* 데이터셋 버전만 비워 둔다. 같은 버전으로 다시 돌리면 같은 모델이 나오므로
                   재학습의 뜻이 없다 — 새 데이터가 담긴 버전을 사람이 골라야 한다. *@
                <MudAlert Severity="Severity.Info" Class="mb-3" Dense="true">
                    지난 학습과 같은 설정을 채웠습니다. <strong>데이터셋 버전만 고르세요</strong> —
                    같은 버전으로 다시 돌리면 같은 모델이 나옵니다.
                </MudAlert>
            }
            <MudGrid>
                <MudItem xs="12" md="6">
                    <MudSelect T="Guid?" @bind-Value="_datasetId" Label="데이터셋 버전" Required="true"
                               HelperText="작업 유형과 내보내기 형식이 스크립트와 맞아야 합니다">
                        @foreach (var d in _datasets)
                        {
                            <MudSelectItem T="Guid?" Value="@d.Id">
                                @d.Name — @Display.TaskTypeText(d.TaskType) / @d.ExportFormat (@Display.Size(d.SizeBytes))
                            </MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" md="6">
                    <MudSelect T="Guid?" @bind-Value="_modelId" Label="결과를 등록할 모델 계열" Required="true"
                               HelperText="학습이 끝나면 여기에 후보 버전이 생깁니다">
                        @foreach (var m in _models)
                        {
                            <MudSelectItem T="Guid?" Value="@m.Id">@m.Name — @Display.TaskTypeText(m.TaskType)</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" md="6">
                    <MudSelect T="TrainingScript" Value="_script" ValueChanged="OnScriptChangedAsync" Label="스크립트">
                        @foreach (var s in Enum.GetValues<TrainingScript>())
                        {
                            <MudSelectItem T="TrainingScript" Value="@s">@s.FileName() (@Display.TaskTypeText(s.TaskType()))</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" md="6">
                    <MudSelect T="string" @bind-Value="_pretrainedRef" Label="사전학습 가중치" Clearable="true"
                               HelperText="서버 미러에서만 받습니다">
                        @foreach (var p in _pretrained)
                        {
                            <MudSelectItem T="string" Value="@p.Ref">@p.Ref (@Display.Size(p.TotalBytes))</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" md="4">
                    <MudTextField @bind-Value="_backbone" Label="백본 (선택)" HelperText="예: dfine-small" />
                </MudItem>
                <MudItem xs="12" md="4">
                    <MudNumericField T="int" @bind-Value="_seed" Label="Seed" HelperText="같은 입력·seed 면 같은 결과" />
                </MudItem>
                <MudItem xs="12" md="4">
                    <MudNumericField T="int" @bind-Value="_priority" Label="우선순위" HelperText="큰 값이 먼저 배정됩니다" />
                </MudItem>
            </MudGrid>

            @if (_script == TrainingScript.TrainYolo)
            {
                <MudAlert Severity="Severity.Warning" Class="mt-3" Dense="true">
                    Ultralytics YOLO 는 AGPL-3.0 입니다. Enterprise License 확인 문구를 남겨야 제출됩니다.
                </MudAlert>
                <MudTextField @bind-Value="_license" Label="라이선스 확인" Class="mt-2" Immediate="true"
                              Placeholder="Ultralytics Enterprise #1234" />
            }

            <MudText Typo="Typo.subtitle2" Class="mt-5">하이퍼파라미터</MudText>
            <MudText Typo="Typo.caption" Class="mud-text-secondary">
                이 목록은 서버 화이트리스트입니다. 비워 두면 스크립트 기본값을 씁니다.
            </MudText>
            <MudGrid Class="mt-1">
                @foreach (var spec in _specs)
                {
                    <MudItem xs="6" md="3">
                        @if (spec.Choices is { Length: > 0 })
                        {
                            <MudSelect T="string" Value="@Get(spec.Key)" ValueChanged="@(v => Set(spec.Key, v))"
                                       Label="@spec.Key" Clearable="true" Dense="true">
                                @foreach (var c in spec.Choices)
                                {
                                    <MudSelectItem T="string" Value="@c">@c</MudSelectItem>
                                }
                            </MudSelect>
                        }
                        else
                        {
                            <MudTextField T="string" Value="@Get(spec.Key)" ValueChanged="@(v => Set(spec.Key, v))"
                                          Label="@spec.Key" Margin="Margin.Dense" Immediate="true"
                                          HelperText="@RangeText(spec)" Placeholder="@spec.Default" />
                        }
                    </MudItem>
                }
            </MudGrid>

            @if (_error is not null)
            {
                <MudAlert Severity="Severity.Error" Class="mt-4">@_error</MudAlert>
            }
        }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="@(() => VisibleChanged.InvokeAsync(false))" Disabled="@_submitting">취소</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled"
                   Disabled="@(_submitting || _datasetId is null || _modelId is null)" OnClick="SubmitAsync">제출</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [Parameter] public bool Visible { get; set; }
    [Parameter] public EventCallback<bool> VisibleChanged { get; set; }
    [Parameter] public EventCallback<TrainingJobDto> OnCreated { get; set; }

    /// <summary>
    /// 이 작업의 설정으로 채운 채 연다 (모니터링의 재학습 제안). 데이터셋 버전은 일부러 비워 둔다.
    /// </summary>
    [Parameter] public Guid? PrefillFromJobId { get; set; }

    private List<DatasetVersionDto> _datasets = [];
    private List<ModelDto> _models = [];
    private List<PretrainedAssetDto> _pretrained = [];
    private List<MlopsApi.HyperparamSpecDto> _specs = [];
    private readonly Dictionary<string, string> _values = new(StringComparer.Ordinal);

    private Guid? _datasetId, _modelId;
    private TrainingScript _script = TrainingScript.TrainDfine;
    private string? _pretrainedRef;
    private string _backbone = "", _license = "";
    private int _seed, _priority;
    private bool _loading = true, _submitting, _loaded, _prefilled;
    private Guid? _loadedFor;
    private string? _error;

    protected override async Task OnParametersSetAsync()
    {
        // 다른 작업으로 다시 열리면 그 설정으로 새로 채운다 — 앞서 연 것의 값이 남으면
        // 사람이 고르지 않은 설정으로 학습이 걸린다.
        if (Visible && _loaded && PrefillFromJobId != _loadedFor) _loaded = false;
        if (!Visible || _loaded) return;
        _loaded = true;
        _loadedFor = PrefillFromJobId;
        _loading = true;
        try
        {
            _datasets = await Safe(() => Api.DatasetsAsync());
            _models = await Safe(() => Api.ModelsAsync());
            _pretrained = await Safe(() => Api.PretrainedAsync());
            await LoadSpecsAsync();
            await PrefillAsync();
        }
        finally { _loading = false; }
    }

    /// <summary>
    /// 지난 작업의 설정을 그대로 옮긴다. 하이퍼파라미터는 지금 스크립트의 화이트리스트에 있는 키만
    /// 옮긴다 — 없는 키를 실으면 서버가 통째로 거부한다.
    /// </summary>
    private async Task PrefillAsync()
    {
        _prefilled = false;
        if (PrefillFromJobId is not { } jobId) return;

        TrainingJobDto job;
        try { job = await Api.JobAsync(jobId); }
        catch (MlopsApiException ex) { _error = "지난 학습 설정을 읽지 못했습니다 — " + ex.Describe(); return; }

        // 데이터셋 버전은 비운다 — 앞서 열었을 때 고른 것이 남으면 사람이 고르지 않은 데이터로 학습이 걸린다
        _datasetId = null;
        _modelId = job.ModelId;
        _script = job.Script;
        _backbone = job.Backbone ?? "";
        _pretrainedRef = job.PretrainedRef;
        _seed = job.Seed;
        _priority = job.Priority;
        await LoadSpecsAsync();

        _values.Clear();
        foreach (var (key, value) in job.Hyperparams)
            if (_specs.Any(s => s.Key == key)) _values[key] = value;

        _prefilled = true;
    }

    private static async Task<List<T>> Safe<T>(Func<Task<List<T>>> call)
    {
        try { return await call(); }
        catch (MlopsApiException) { return []; }
    }

    private async Task OnScriptChangedAsync(TrainingScript script)
    {
        _script = script;
        await LoadSpecsAsync();
    }

    private async Task LoadSpecsAsync()
    {
        try
        {
            _specs = await Api.HyperparamsAsync(_script);
            // 스크립트를 바꾸면 그 스크립트에 없는 키는 버린다 (서버가 거부할 값)
            foreach (var key in _values.Keys.ToList())
                if (_specs.All(s => s.Key != key)) _values.Remove(key);
        }
        catch (MlopsApiException ex) { _error = ex.Describe(); }
    }

    private string Get(string key) => _values.GetValueOrDefault(key, "");

    private void Set(string key, string? value)
    {
        if (string.IsNullOrWhiteSpace(value)) _values.Remove(key);
        else _values[key] = value.Trim();
    }

    private static string RangeText(MlopsApi.HyperparamSpecDto spec) =>
        spec.Min is not null && spec.Max is not null ? $"{spec.Type} · {spec.Min}~{spec.Max}" : spec.Type;

    private async Task SubmitAsync()
    {
        _submitting = true;
        _error = null;
        try
        {
            // 값은 문자열로 모으고 서버 화이트리스트가 타입·범위를 검증한다
            var hyperparams = System.Text.Json.JsonSerializer.SerializeToElement(_values, MlopsJson.Options);
            var created = await Api.CreateJobAsync(new CreateTrainingJobRequest(
                _datasetId!.Value, _modelId!.Value, _script,
                string.IsNullOrWhiteSpace(_backbone) ? null : _backbone,
                string.IsNullOrWhiteSpace(_pretrainedRef) ? null : _pretrainedRef,
                hyperparams, _seed, _priority, null, false,
                string.IsNullOrWhiteSpace(_license) ? null : _license));

            await VisibleChanged.InvokeAsync(false);
            await OnCreated.InvokeAsync(created);
        }
        catch (MlopsApiException ex)
        {
            _error = ex.Code == ErrorCodes.DuplicateJob
                ? $"{ex.Message} 설정을 바꾸거나 같은 조건으로 다시 돌리려면 작업 상세에서 '같은 설정으로 재실행' 을 쓰세요."
                : ex.Describe();
        }
        finally { _submitting = false; }
    }
}
