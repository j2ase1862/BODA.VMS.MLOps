{
  "_comment": "운영(서비스) 설정 템플릿. scripts/install-server-service.ps1 이 {{...}} 를 채워 설치 폴더에 appsettings.Production.json 으로 놓는다. Jwt:Key 는 여기 두지 않고 서비스 환경변수 Jwt__Key 로 준다 (운영 웹과 같은 키).",

  "Urls": "http://0.0.0.0:{{Port}}",

  "ConnectionStrings": {
    "DefaultConnection": "Data Source={{DataDir}}/mlops.db"
  },

  "Auth": {
    "EnableDevTokens": false
  },

  "Mlops": {
    "_comment": "이미지·데이터셋·모델 아티팩트. 큰 드라이브에 두고 백업 대상에 넣는다.",
    "StorageRoot": "{{DataDir}}/storage"
  },

  "Monitoring": {
    "_comment": "운영 웹 내부 주소. 비우면 모니터링만 꺼진다.",
    "ProductionWebUrl": "{{ProductionWebUrl}}"
  },

  "Serilog": {
    "_comment": "서비스로 돌면 콘솔 출력은 아무 데도 가지 않는다. 날짜별 파일 30일 보존.",
    "Using": [ "Serilog.Sinks.File" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "File",
        "Args": {
          "path": "{{DataDir}}/logs/server-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 30,
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff} [{Level:u3}] {SourceContext}: {Message:lj}{NewLine}{Exception}"
        }
      }
    ]
  }
}
