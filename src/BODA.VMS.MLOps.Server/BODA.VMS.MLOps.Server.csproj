<Project Sdk="Microsoft.NET.Sdk.Web">
  <!--
    MLOps 관리 서버 — 모델 레지스트리(Phase 1) + 학습 작업 큐·워커 레지스트리(Phase 3) API.
    BODA.VMS.Web 와 같은 JWT 키·발급자를 쓰면 기존 로그인 토큰을 그대로 받는다 (appsettings Jwt 섹션).
    DB: SQLite(WAL) · 스토리지: 로컬 디스크(IArtifactStorage 추상화, MinIO 전환 대비).
  -->
  <PropertyGroup>
    <RootNamespace>BODA.VMS.MLOps.Server</RootNamespace>
    <UserSecretsId>boda-vms-mlops-5b1c2d3e-4f60-4a71-9b82-c3d4e5f60718</UserSecretsId>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="8.0.*" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="8.0.*" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="8.0.*">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="8.0.*" />
    <PackageReference Include="Serilog.AspNetCore" Version="8.*" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="6.*" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.Server" Version="8.0.*" />
    <!-- 이미지 디코딩·축소본·지각 해시. MIT 라이선스라 허용 목록(개발 문서 §8)에 맞는다.
         ImageSharp 3.x 는 Six Labors Split License 로 상용 제약이 있어 쓰지 않는다. -->
    <PackageReference Include="SkiaSharp" Version="2.88.9" />
    <PackageReference Include="SkiaSharp.NativeAssets.Win32" Version="2.88.9" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\BODA.VMS.MLOps.Core\BODA.VMS.MLOps.Core.csproj" />
    <ProjectReference Include="..\BODA.VMS.MLOps.Contracts\BODA.VMS.MLOps.Contracts.csproj" />
    <!-- 관리 화면(Blazor WASM)을 이 서버가 정적 파일로 내보낸다 — 같은 오리진이라 CORS 가 필요 없다 -->
    <ProjectReference Include="..\BODA.VMS.MLOps.Client\BODA.VMS.MLOps.Client.csproj" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="BODA.VMS.MLOps.Tests" />
  </ItemGroup>
  <ItemGroup>
    <!-- 워커에 배포하는 학습 스크립트 원본 (VMS 리포 VMS.DeepLearning/scripts 와 동일 규약) → 출력 scripts\ -->
    <None Include="..\..\scripts\train_*.py" Link="scripts\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
