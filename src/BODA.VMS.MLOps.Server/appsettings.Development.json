{
  "ConnectionStrings": {
    "DefaultConnection": "Data Source=mlops-dev.db"
  },
  "Jwt": {
    "Key": "dev-only-key-change-me-0123456789abcdef0123456789"
  },
  "Auth": {
    "EnableDevTokens": true
  },
  "Mlops": {
    "StorageRoot": ".dev-storage",
    "HeartbeatLostSec": 90,
    "SupervisorIntervalSec": 5
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information"
    }
  }
}
